# ═══════════════════════════════════════════════
# MakeChurchEazy — API Environment Variables
# ═══════════════════════════════════════════════
# Copy this file to .env (development) or
# configure in GitHub Environments (production).
# ═══════════════════════════════════════════════

# ── Environment ─────────────────────────────────
# Controls branding and behavior. "development" or "production".
NEXT_PUBLIC_APP_ENV=development
APP_ENV=development

# ── MongoDB ─────────────────────────────────────
# For production, use MongoDB Atlas connection string.
MONGODB_URI="mongodb://localhost:27017/makechurcheasy"

# ── Auth / Session ──────────────────────────────
# Generate AUTH_SECRET with: openssl rand -base64 48
AUTH_SECRET="change-me-generate-a-random-secret"
PAYLOAD_SECRET="change-me-generate-a-separate-random-secret"

# One-free-trial-per-computer records are hashed with this value.
# Set it ONCE and NEVER change it, or every computer can start a new trial.
# Existing deployments: set it to the value the API used before, i.e.
# JWT_SECRET if set, else NEXTAUTH_SECRET, else "makechurcheasy-trial-abuse-v1".
TRIAL_ABUSE_SALT=""
# Leave unset (default: a desktop hardware fingerprint is required for a trial).
# TRIAL_REQUIRE_DEVICE_FINGERPRINT="true"
# Opt-in: also block by IP + user agent (bad for churches sharing one network).
# TRIAL_BLOCK_IP_UA="false"
AUTH_URL="http://localhost:3001"

# Google OAuth
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Firebase Admin ──────────────────────────────
# Full service-account JSON (minified single line)
FIREBASE_SERVICE_ACCOUNT_KEY=''
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# ── URLs ────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:4000"
NEXT_PUBLIC_API_URL="http://localhost:3004"

# ── Flutterwave Standard (primary card and local payments) ─────────────────
# Keep secret and encryption keys on the API. Use test credentials locally.
FLW_PUBLIC_KEY="FLWPUBK-..."
FLW_SECRET_KEY="FLWSECK-..."
FLW_ENCRYPTION_KEY="..."
FLW_SECRET_HASH=""
FLW_SUPPORTED_CURRENCIES="NGN,GHS,KES,ZAR,UGX,TZS,RWF,USD,GBP,EUR"

# Legacy only: required while existing Paystack saved authorizations renew.
PAYSTACK_SECRET_KEY=""

# ── MTN MoMo Collection (optional) ─────────────────────────────────────────
# The checkout uses Collection RequestToPay. Keep all MoMo credentials on the API.
# The linked bc-authorize endpoint is a consent flow, not the charge endpoint.
# Configure one live MoMo Collection market per API deployment. For Nigeria use
# target environment mtnnigeria, country NG, and currency NGN.
MTN_MOMO_ENABLED="false"
MTN_MOMO_BASE_URL="https://sandbox.momodeveloper.mtn.com"
MTN_MOMO_TARGET_ENVIRONMENT="sandbox"
MTN_MOMO_COUNTRY_CODE="GH"
MTN_MOMO_ALLOWED_COUNTRIES="GH"
# MTN's shared sandbox uses EUR. Production uses the local currency, e.g. GHS.
MTN_MOMO_CURRENCY="EUR"
MTN_MOMO_COLLECTION_SUBSCRIPTION_KEY=""
MTN_MOMO_API_USER=""
MTN_MOMO_API_KEY=""
# Optional public callback endpoint: https://api.example.com/api/webhooks/mtn-momo
MTN_MOMO_CALLBACK_URL=""
MTN_MOMO_REQUEST_TIMEOUT_MS="10000"

# ── NOWPayments crypto checkout (optional) ─────────────────────────────────
# Keep both secrets server-side. The callback URL must be publicly reachable.
NOWPAYMENTS_API_KEY=""
NOWPAYMENTS_IPN_SECRET=""
NOWPAYMENTS_IPN_CALLBACK_URL="https://api.example.com/api/webhooks/nowpayments"
NOWPAYMENTS_DEFAULT_PAY_CURRENCY=""
NOWPAYMENTS_FEE_PAID_BY_USER="false"
NOWPAYMENTS_FIXED_RATE="false"
# Override only if the account supports a different set of price currencies.
NOWPAYMENTS_SUPPORTED_PRICE_CURRENCIES="USD,NGN,EUR,GBP,CAD,AUD,INR,PHP,ZAR"

# ── Email (SMTP / transactional providers) ───────
SMTP_HOST="127.0.0.1"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="noreply@notifications.makechurcheazy.com"
EMAIL_FROM_NAME="MakeChurchEazy"
EMAIL_REPLY_TO=""
SUPPORT_EMAIL="support@makechurcheazy.com"
# Production provider: Cloudflare Email Service (or console fallback in dev)
EMAIL_PROVIDER="cloudflare"
# Cloudflare Email Service credentials (domain onboarded in Cloudflare)
CLOUDFLARE_EMAIL_ACCOUNT_ID=""
CLOUDFLARE_EMAIL_API_TOKEN=""
EMAIL_UNSUBSCRIBE_SECRET=""

# Optional verified-signup welcome workflow in Zoho Campaigns.
# Requires a Zoho OAuth refresh token with ZohoCampaigns.contact.CREATE-UPDATE,
# the MCE New Signups list key, and the Zoho list's signup form disabled.
# Admin > Contacts (pulling contacts from Zoho) also needs ZohoCampaigns.contact.READ
# on the same refresh token. Optionally limit it to some lists (comma separated keys):
# ZOHO_CAMPAIGNS_CONTACT_SYNC_LIST_KEYS=""
ZOHO_CAMPAIGNS_CLIENT_ID=""
ZOHO_CAMPAIGNS_CLIENT_SECRET=""
ZOHO_CAMPAIGNS_REFRESH_TOKEN=""
ZOHO_CAMPAIGNS_NEW_SIGNUPS_LIST_KEY=""
ZOHO_CAMPAIGNS_SIGNUP_FORM_DISABLED="false"

# ── R2 Storage (Cloudflare) ─────────────────────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_ENDPOINT=""
R2_PUBLIC_BASE_URL=""
R2_PREFIX=""

# ── Analytics ───────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
NEXT_PUBLIC_GA_ID=""

# ── Telegram notifications (optional) ──────────
# Create a bot with BotFather, then set the private token and destination chat ID.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
TELEGRAM_NOTIFICATIONS_ENABLED="true"
TELEGRAM_NOTIFICATION_TIMEZONE="Africa/Lagos"
# API errors are reported to the same MakeChurchEazy Alerts chat. Repeated
# identical errors are grouped for this many milliseconds to prevent alert floods.
TELEGRAM_API_ERROR_ALERTS_ENABLED="true"
TELEGRAM_API_ERROR_COOLDOWN_MS="60000"

# ── AI / OpenCode ───────────────────────────────
OPENCODE_API_KEY=""
OPENCODE_MODEL="mimo-v2.5-free"
OPENCODE_MAX_TOKENS=""
OPENCODE_TIMEOUT_MS=""

# ── Scheduled Jobs ──────────────────────────────
# Used to authenticate Cloudflare cron requests.
# Generate with: openssl rand -hex 32
CRON_SECRET=""

# ── Subscription ────────────────────────────────
SUBSCRIPTION_PRIVATE_KEY=""

# ── Cloudflare Stream Broadcasting Engine ──
CLOUDFLARE_STREAM_ACCOUNT_ID=""
CLOUDFLARE_STREAM_API_TOKEN=""

    "@tauri-apps/plugin-store": "^2.2.0",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@types/fabric": "^5.3.0",
    "@types/qrcode": "^1.5.6",
    "@xenova/transformers": "^2.17.2",
    "docx": "^9.7.1",

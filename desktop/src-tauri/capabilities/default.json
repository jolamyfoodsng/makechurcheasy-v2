{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main",
    "makechurcheasy-pet",
    "mce-vmix-dock"
  ],
  "permissions": [
    "core:default",
    "core:webview:allow-create-webview-window",
    "core:window:allow-current-monitor",
    "core:window:allow-hide",
    "core:window:allow-is-visible",
    "core:window:allow-set-focus",
    "core:window:allow-set-position",
    "core:window:allow-set-size",
    "core:window:allow-start-dragging",
    "core:window:allow-show",
    "core:window:allow-unminimize",
    "core:window:allow-set-fullscreen",
    "core:window:allow-set-always-on-top",
    "core:window:allow-destroy",
    "core:window:allow-close",
    "opener:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "x-apple.systempreferences:*" },
        { "url": "ms-settings:*" }
      ]
    },
    "shell:allow-open",
    "store:default",
    "dialog:default",
    "dialog:allow-save",
    "fs:default",
    "fs:allow-write-file",
    "fs:allow-mkdir",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "**"
        }
      ]
    },
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://versecast-bible-api.solitary-credit-34b2.workers.dev/*"
        },
        {
          "url": "https://*.r2.cloudflarestorage.com/*"
        },
        {
          "url": "https://*.r2.dev/*"
        },
        {
          "url": "https://api.github.com/*"
        },
        {
          "url": "https://github.com/*"
        },
        {
          "url": "https://release-assets.githubusercontent.com/*"
        },
        {
          "url": "http://localhost:3004/*"
        },
        {
          "url": "http://localhost:4000/*"
        },
        {
          "url": "https://api.makechurcheazy.com/*"
        },
        {
          "url": "https://accounts.google.com/*"
        },
        {
          "url": "https://graph.facebook.com/*"
        },
        {
          "url": "https://translate.googleapis.com/*"
        }
      ]
    }
  ]
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MakeChurchEasy",
  "version": "4.3.14",
  "identifier": "com.makechurcheasy.desktop",
  "build": {
    "beforeDevCommand": "node scripts/prepare-bundle-assets.cjs && npm run mobile:web && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/prepare-bundle-assets.cjs && npm run mobile:web && npm run build",
    "beforeBundleCommand": "node scripts/prepare-bundle-assets.cjs",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "MakeChurchEazy",
        "width": 1280,
        "height": 820,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "visible": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "dangerousDisableAssetCspModification": [
        "script-src",
        "style-src"
      ],
      "csp": "default-src 'self' asset: data: blob:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' asset: data: blob: http://127.0.0.1:* http://localhost:* http://*:45678 https:; font-src 'self' data: https://fonts.gstatic.com; frame-src 'self' http://127.0.0.1:* http://localhost:* https://www.youtube-nocookie.com https://www.youtube.com; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:* http://*:45678 ws://127.0.0.1:* ws://localhost:* wss://streaming.assemblyai.com https://api.github.com https://github.com https://versecast-bible-api.solitary-credit-34b2.workers.dev https://*.r2.cloudflarestorage.com https://*.r2.dev https://*.workers.dev https://app.posthog.com https://us.i.posthog.com http://localhost:4000 https://accounts.google.com https://graph.facebook.com https://api.makechurcheazy.com https://lrclib.net https://translate.googleapis.com;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": [
      "../dist/mce-bible-overlay.html",
      "../dist/mce-worship-overlay.html",
      "../dist/mce-note.html",
      "../dist/studio-output.html",
      "../dist/mce-media-overlay.html",
      "../dist/bible-overlay-bg.html",
      "../dist/bible-kjv.json",
      "../dist/lower-third-overlay.html",
      "../dist/pre-service-countdown.html",
      "../dist/pre-service-media.html",
      "../dist/countdown-overlay.html",
      "../dist/countdown-bg-overlay.html",
      "../dist/rundown-presenter.html",
      "../dist/live-tool-overlay.html",
      "../dist/time-overlay.html",
      "../dist/mce-template-overlay.html",
      "../dist/dock.html",
      "../dist/lm-dock.html",
      "resources/obs-move-transition/**/*",
      "resources/obs-mce-bridge/**/*",
      "resources/ffmpeg/**/*",
      "resources/app_icons/**/*",
      "../dist/app_icons/**/*",
      "../dist/animated-lower-thirds/**/*",
      "../dist/assets/**/*",
      "../dist/fonts/**/*",
      "../dist/mobile/**/*",
      "../dist/kinetic/**/*",
      "../dist/tailwind.min.css",
      "../dist/theme-renderer.js",
      "../dist/logos/**/*",
      "../dist/templates/**/*",
      "../dist/lower_thirds_images/**/*"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "windows-installer-hooks.nsh"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "entitlements": "entitlements.plist",
      "infoPlist": "Info.plist"
    },
    "icon": [
      "icons/16x16.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg4QUQxNTRDNDlFOUREREUKUldUZTNlbEpUQld0aU5nRzUvU0JuWnQ0b1VNRUR5VVhYQmtvRjIyK2tYbXNxMUZwdnF4bGVkVXUK",
      "endpoints": [
        "https://github.com/jolamyfoodsng/makechurcheasy/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}

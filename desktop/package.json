{
  "name": "makechurcheasy",
  "private": true,
  "version": "4.3.14",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "build": "npm run build:theme-renderer && tsc && vite build",
    "build:theme-renderer": "node scripts/build-theme-renderer.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "mobile:web": "node scripts/prepare-mobile-web.cjs",
    "mobile:web:build": "node scripts/prepare-mobile-web.cjs --build",
    "check:locales": "node ../scripts/check-locales.cjs",
    "generate:embeddings": "node scripts/generate-bible-embeddings.cjs",
    "sync:local-llm-model": "node scripts/sync-local-llm-model.cjs",
    "sync:google-fonts": "node scripts/sync-google-font-catalog.mjs",
    "version:patch": "npm version patch --no-git-tag-version && node scripts/sync-version.cjs",
    "version:minor": " npm run build  && npm version minor --no-git-tag-version &&  node scripts/sync-version.cjs",
    "version:major": "npm run build  && npm version major --no-git-tag-version && node scripts/sync-version.cjs",
    "release:patch": "node scripts/release.cjs patch",
    "release:minor": "node scripts/release.cjs minor",
    "release:major": "node scripts/release.cjs major",
    "latest": " node scripts/generate-update-json.cjs"
  },

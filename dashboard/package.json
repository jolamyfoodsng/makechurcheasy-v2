{
  "name": "makechurcheasy-dashboard",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "next dev -p 4000",
    "build": "next build --webpack",
    "build:cloudflare": "opennextjs-cloudflare build",
    "preview:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "start": "next start",
    "lint": "tsc --noEmit",
    "check:locales": "node ../scripts/check-locales.cjs"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^14.0.0",
    "browser-image-compression": "^2.0.2",
    "clsx": "^2.1.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "next": "16.4.2",
    "next-intl": "^4.13.0",
    "otpauth": "^9.5.1",
    "react": "^19.0.1",
    "react-confetti": "^6.4.0",
    "react-dom": "^19.0.1",
    "react-medium-image-zoom": "^5.4.8",
    "react-router-dom": "^7.18.0",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.13",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.14.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "wrangler": "4.151.3"
  }
}

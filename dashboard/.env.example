# ═══════════════════════════════════════════════
# MakeChurchEazy — Dashboard Environment Variables
# ═══════════════════════════════════════════════
# Copy this file to .env (development) or
# configure in GitHub Environments (production).
# ═══════════════════════════════════════════════

# ── Environment ─────────────────────────────────
NEXT_PUBLIC_APP_ENV=development

# ── Backend API ─────────────────────────────────
BACKEND_URL=http://localhost:3004
NEXT_PUBLIC_API_URL=http://localhost:3004

# ── Google Analytics ────────────────────────────
# GA4 measurement ID, for example G-XXXXXXXXXX.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
# "Account Update" pop-ups from the server. Leave off until /api/user/modals is deployed on the API.
NEXT_PUBLIC_USER_MODALS=false

# ── Firebase ────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""


# ── Local admin release mirroring ────────────────
# Optional. The Release Mirror admin page also works with `gh auth login`.
RELEASE_MIRROR_GITHUB_TOKEN=""
